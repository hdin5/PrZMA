# Copy this file to .env and fill only the values required by your environment.
# Never commit the populated .env file.

# Model access. OPENAI_MODEL and OPENAI_REASONING_EFFORT are optional when
# equivalent values are supplied by the selected evaluation Config.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=

# Optional web entry point used only by workflows that require web interaction.
WEB_URL=

# Tool Manual Interpreter input. Supply either a URL or a local path.
TMI_TOOL_NAME=
TMI_TOOL_VERSION=
TMI_TOOL_MANUAL_URL=
TMI_TOOL_MANUAL_PATH=

# Optional path to the locally installed Chromium-cache parser.
PRZMA_CCL_CHROMIUM_CACHE=

# VMware encryption and Windows guest credentials.
VM_PASSWORD=
VM_GUEST_PASSWORD=

# Service credentials used only by scenarios that require the corresponding
# prepared accounts. Leave unused entries blank.
DISCORD_A1_EMAIL=
DISCORD_A1_PASSWORD=
DISCORD_A2_EMAIL=
DISCORD_A2_PASSWORD=
DISCORD_A3_EMAIL=
DISCORD_A3_PASSWORD=
DISCORD_A4_EMAIL=
DISCORD_A4_PASSWORD=

# Scenario-specific conversation targets.
DISCORD_MEETING_CHANNEL=
TELEGRAM_MEETING_CHAT=
